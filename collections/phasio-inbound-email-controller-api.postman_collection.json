      "item": [
        {
          "id": "6adb0060-42c9-4436-b978-7dc970252fcf",
          "name": "Process inbound email",
          "request": {
            "name": "Process inbound email",
            "description": {
              "content": "Processes an incoming email and associates it with a thread or creates a new thread",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "internal",
                "v1",
                "inbound-email"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fromEmail",
                  "value": "<string>",
                  "description": "(Required) Email address of the sender"
                },
                {
                  "disabled": false,
                  "key": "subject",
                  "value": "<string>",
                  "description": "(Required) Subject line of the email"
                },
                {
                  "disabled": false,
                  "key": "body",
                  "value": "<string>",
                  "description": "(Required) Body content of the email"
                },
                {
                  "disabled": false,
                  "key": "threadId",
                  "value": "<long>",
                  "description": "ID of an existing thread to associate the email with (optional)"
                },
                {
                  "disabled": false,
                  "key": "spf",
                  "value": "<boolean>",
                  "description": "(Required) Whether the email passed SPF authentication"
                },
                {
                  "disabled": false,
                  "key": "dkim",
                  "value": "<boolean>",
                  "description": "(Required) Whether the email passed DKIM authentication"
                },
                {
                  "disabled": false,
                  "key": "notSpam",
                  "value": "<boolean>",
                  "description": "(Required) Whether the email was determined to be legitimate (not spam)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "attachments",
                  "value": "[\"<binary>\",\"<binary>\"]",
                  "type": "text",
                  "description": "Files attached to the email (optional)"
                }
              ]
            }
          },
