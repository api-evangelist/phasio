{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Operator Addresses API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Operator Addresses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an operator address by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/operator/address/:addressId",
            "params": [
              {
                "name": "addressId",
                "value": "1",
                "type": "path",
                "description": "ID of the address to retrieve"
              }
            ]
          },
          "docs": "Retrieves address details for the specified operator address ID"
        },
        {
          "info": {
            "name": "Edit an existing operator address",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/operator/address/:addressId",
            "params": [
              {
                "name": "addressId",
                "value": "1",
                "type": "path",
                "description": "ID of the address to edit"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new address with the updated details, soft-deletes the old address, and transfers billing and shipping defaults if applicable"
        },
        {
          "info": {
            "name": "Delete an operator address",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/operator/address/:addressId",
            "params": [
              {
                "name": "addressId",
                "value": "1",
                "type": "path",
                "description": "ID of the address to delete"
              }
            ]
          },
          "docs": "Soft-deletes the specified operator address"
        },
        {
          "info": {
            "name": "List operator addresses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/operator/address"
          },
          "docs": "Retrieves all non-deleted addresses for the current operator"
        },
        {
          "info": {
            "name": "Create a new operator address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/operator/address",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new ship-from / facility address for the current operator"
        },
        {
          "info": {
            "name": "Set address as default shipping address",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/operator/address/:addressId/shipping",
            "params": [
              {
                "name": "addressId",
                "value": "1",
                "type": "path",
                "description": "ID of the address to set as shipping address"
              }
            ]
          },
          "docs": "Marks an operator address as the default shipping address"
        },
        {
          "info": {
            "name": "Set address as default billing address",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/operator/address/:addressId/billing",
            "params": [
              {
                "name": "addressId",
                "value": "1",
                "type": "path",
                "description": "ID of the address to set as billing address"
              }
            ]
          },
          "docs": "Marks an operator address as the default billing address"
        }
      ]
    }
  ],
  "bundled": true
}