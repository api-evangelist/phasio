{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Customer Project Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Project Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/customer/v1/project",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index (0..N)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The size of the page to be returned"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported."
              }
            ]
          },
          "docs": "Retrieves projects for the current customer with optional filtering and pagination"
        },
        {
          "info": {
            "name": "Create project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/customer/v1/project",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new project for the current customer"
        },
        {
          "info": {
            "name": "Get project by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/customer/v1/project/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project to retrieve"
              }
            ]
          },
          "docs": "Retrieves a specific project by its unique identifier"
        },
        {
          "info": {
            "name": "Get project count",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/customer/v1/project/count",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "List of project statuses to filter by"
              }
            ]
          },
          "docs": "Retrieves the count of projects for the current customer with optional filtering"
        }
      ]
    }
  ],
  "bundled": true
}