{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Manufacturer Cart Item Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Cart Item Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a cart item by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/cart-item/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the cart item to retrieve"
              }
            ]
          },
          "docs": "Retrieves a specific cart item by its ID"
        },
        {
          "info": {
            "name": "Get all items in a cart",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/cart-item/cart/:cartId",
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path",
                "description": "ID of the cart to retrieve items for"
              }
            ]
          },
          "docs": "Retrieves all cart items associated with the specified cart"
        }
      ]
    }
  ],
  "bundled": true
}