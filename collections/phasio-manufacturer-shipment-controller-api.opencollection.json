{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Manufacturer Shipment Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Shipment Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Calculate the shipping rates for a group of parts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/shipment/rates",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint calculates the shipping rates for a group of parts. The request body should contain the list of parts and their quantities."
        },
        {
          "info": {
            "name": "Get shipment by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/shipment/:shipmentId",
            "params": [
              {
                "name": "shipmentId",
                "value": "",
                "type": "path",
                "description": "ID of the shipment to retrieve"
              }
            ]
          },
          "docs": "Retrieves a specific shipment by its ID"
        }
      ]
    }
  ],
  "bundled": true
}