{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Customer Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current customer profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/customer/v1/customer"
          },
          "docs": "Retrieves information about the currently authenticated customer user"
        },
        {
          "info": {
            "name": "Update customer profile",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/customer/v1/customer",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates information for the currently authenticated customer"
        },
        {
          "info": {
            "name": "Delete customer account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://m-api.eu.phas.io/api/customer/v1/customer"
          },
          "docs": "Deletes the currently authenticated customer's account and associated data"
        }
      ]
    }
  ],
  "bundled": true
}