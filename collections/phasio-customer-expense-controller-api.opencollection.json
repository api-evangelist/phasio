{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Customer Expense Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Expense Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an expense by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/customer/v1/expense/:expenseId",
            "params": [
              {
                "name": "expenseId",
                "value": "1",
                "type": "path",
                "description": "ID of the expense to retrieve"
              }
            ]
          },
          "docs": "Get an expense by ID"
        },
        {
          "info": {
            "name": "Get all expenses for an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/customer/v1/expense/order/:orderId",
            "params": [
              {
                "name": "orderId",
                "value": "1",
                "type": "path",
                "description": "ID of the order to get expenses for"
              }
            ]
          },
          "docs": "Get all expenses for an order"
        }
      ]
    }
  ],
  "bundled": true
}