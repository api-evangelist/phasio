              "raw": "{\n  \"analysisVersion\": \"<integer>\",\n  \"area\": \"<number>\",\n  \"baseRotation\": [\n    [\n      \"<number>\",\n      \"<number>\"\n    ],\n    [\n      \"<number>\",\n      \"<number>\"\n    ]\n  ],\n  \"baseTranslation\": [\n    \"<number>\",\n    \"<number>\"\n  ],\n  \"convexHullVolume\": \"<number>\",\n  \"fileHash\": \"<string>\",\n  \"height\": \"<number>\",\n  \"length\": \"<number>\",\n  \"minBoundingBoxVolume\": \"<number>\",\n  \"repaired\": \"<boolean>\",\n  \"shrinkWrapVolume\": \"<number>\",\n  \"stl\": \"<byte>\",\n  \"thumbnails\": [\n    {\n      \"data\": \"<byte>\",\n      \"direction\": \"<string>\",\n      \"similarityVector\": [\n        \"<number>\",\n        \"<number>\"\n      ]\n    },\n    {\n      \"data\": \"<byte>\",\n      \"direction\": \"<string>\",\n      \"similarityVector\": [\n        \"<number>\",\n        \"<number>\"\n      ]\n    }\n  ],\n  \"volume\": \"<number>\",\n  \"watertight\": \"<boolean>\",\n  \"width\": \"<number>\",\n  \"wallThickness\": \"<byte>\",\n  \"minimumWallThickness\": \"<number>\",\n  \"similarityVector\": [\n    \"<number>\",\n    \"<number>\"\n  ],\n  \"partRevisionId\": \"<uuid>\",\n  \"creationMethod\": \"<string>\",\n  \"fileName\": \"<string>\",\n  \"analysisId\": \"<uuid>\",\n  \"createdAt\": \"<string>\",\n  \"originalCadFileType\": \"<string>\",\n  \"availableAccessories\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"versionNumber\": \"<long>\"\n}"
