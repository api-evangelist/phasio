{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Customer Organisation Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Organisation Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get customer organisation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/customer/v1/customer-organisation"
          },
          "docs": "Retrieves details of the current customer's organization"
        },
        {
          "info": {
            "name": "Update customer organisation",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/customer/v1/customer-organisation",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates details of the current customer's organization"
        }
      ]
    }
  ],
  "bundled": true
}