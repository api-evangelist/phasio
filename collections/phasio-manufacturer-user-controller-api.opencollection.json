{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Manufacturer User Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer User Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current user information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/user"
          },
          "docs": "Retrieves information about the currently logged in user"
        },
        {
          "info": {
            "name": "Update user information",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/user",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates information for the current user"
        },
        {
          "info": {
            "name": "Check if user exists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/user/exists",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "query",
                "description": "Base64-encoded username to check"
              }
            ]
          },
          "docs": "Checks if a user with the specified username exists"
        }
      ]
    }
  ],
  "bundled": true
}