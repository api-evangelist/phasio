          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/accounting/registered"
          }
        },
        {
          "info": {
            "name": "getOrganisations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/accounting/organisations"
          }
        },
        {
          "info": {
            "name": "Get all accounting system customers (paginated)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/accounting/customers",
            "params": [
              {
                "name": "page",
                "value": "",
