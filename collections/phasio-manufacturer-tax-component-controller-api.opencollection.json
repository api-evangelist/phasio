{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Manufacturer Tax Component Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Tax Component Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all tax components",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/tax-component"
          },
          "docs": "Retrieves all tax components in the system"
        },
        {
          "info": {
            "name": "Create tax component",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/tax-component",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new tax component with specified rate"
        },
        {
          "info": {
            "name": "Update tax component",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/tax-component/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the tax component to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing tax component"
        },
        {
          "info": {
            "name": "Delete tax component",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/tax-component/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the tax component to delete"
              }
            ]
          },
          "docs": "Deletes an existing tax component"
        }
      ]
    }
  ],
  "bundled": true
}