{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Manufacturer Lead Time Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Lead Time Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get lead time by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/lead-time/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the lead time to retrieve"
              }
            ]
          },
          "docs": "Retrieves a specific lead time option by its unique identifier"
        },
        {
          "info": {
            "name": "Update lead time",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/lead-time/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the lead time to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing lead time option"
        },
        {
          "info": {
            "name": "Delete lead time",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/lead-time/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the lead time to delete"
              }
            ]
          },
          "docs": "Deletes an existing lead time option"
        },
        {
          "info": {
            "name": "Get all lead times",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/lead-time"
          },
          "docs": "Retrieves all available lead time options"
        },
        {
          "info": {
            "name": "Create lead time",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/lead-time",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new lead time option"
        }
      ]
    }
  ],
  "bundled": true
}