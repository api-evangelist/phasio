{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Manufacturer Assembly Controller API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Assembly Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get assembly by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/assemblies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Assembly ID"
              }
            ]
          },
          "docs": "Retrieves a specific assembly by its ID"
        },
        {
          "info": {
            "name": "Update assembly",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/assemblies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Assembly ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing assembly"
        },
        {
          "info": {
            "name": "Delete assembly",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/assemblies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Assembly ID"
              }
            ]
          },
          "docs": "Deletes an assembly"
        },
        {
          "info": {
            "name": "List assemblies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/assemblies",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "filter specification"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index (0..N)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The size of the page to be returned"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Optional search term"
              }
            ]
          },
          "docs": "Retrieves a paginated list of assemblies with optional filtering and search"
        },
        {
          "info": {
            "name": "Create assembly",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/assemblies",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new assembly with items"
        },
        {
          "info": {
            "name": "Add assembly to catalog",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/assemblies/:id/catalog",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Assembly ID"
              },
              {
                "name": "customerOrganisationId",
                "value": "",
                "type": "query",
                "description": "Customer organisation ID"
              },
              {
                "name": "reference",
                "value": "",
                "type": "query",
                "description": "Customer reference"
              }
            ]
          },
          "docs": "Adds an assembly to a customer's catalog"
        }
      ]
    }
  ],
  "bundled": true
}