{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Manufacturer Search Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Search Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Global search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/search",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query string"
              }
            ]
          },
          "docs": "Returns the top-ranked matches across all searchable entity types for the given query. Capped at 5 hits per entity type. Frontend groups results by entityType and hides empty sections."
        }
      ]
    }
  ],
  "bundled": true
}