{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Manufacturer Document Template Controller API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Document Template Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all document templates for operator",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/document-template"
          },
          "docs": "Retrieves all document templates associated with the current operator"
        },
        {
          "info": {
            "name": "Get document template by language and type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/document-template/operator",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "query",
                "description": "Language of the document template"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Type of the document template"
              }
            ]
          },
          "docs": "Retrieves a specific document template for the current operator by language and template type"
        }
      ]
    }
  ],
  "bundled": true
}