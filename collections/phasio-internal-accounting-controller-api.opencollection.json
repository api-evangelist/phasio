{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Internal Accounting Controller API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Internal Accounting Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "registerOAuthIntegration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/internal/v1/accounting/oauth/register",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "synchronizeCustomerOrganisation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/internal/v1/accounting/customer-organisation/:accountingSystemCustomerOrganisationId/synchronize",
            "params": [
              {
                "name": "accountingSystemCustomerOrganisationId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Disassociate accounting system",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://m-api.eu.phas.io/api/internal/v1/accounting"
          },
          "docs": "Removes the association between the current operator and its accounting system"
        }
      ]
    }
  ],
  "bundled": true
}