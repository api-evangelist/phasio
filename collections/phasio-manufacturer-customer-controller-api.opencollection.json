        {
          "info": {
            "name": "Get a customer by email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer/email",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a customer using their email address. Always returns 200 - exists flag indicates whether a match was found."
