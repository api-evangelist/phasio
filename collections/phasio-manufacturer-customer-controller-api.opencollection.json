            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new customer record"
        },
        {
          "info": {
            "name": "Update a customer",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing customer record"
        },
        {
          "info": {
            "name": "Upload customers from a file",
