        {
          "info": {
            "name": "Get a customer by principal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer/principal",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a customer using their principal identifier (username, email, etc.)"
