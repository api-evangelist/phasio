        {
          "info": {
            "name": "Get a customer by phone number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer/phone",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a customer using their phone number. Always returns 200 - exists flag indicates whether a match was found."
        },
        {
