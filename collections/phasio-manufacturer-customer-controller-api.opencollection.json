              }
            ]
          },
          "docs": "Retrieves all customers belonging to a specific organization"
        },
        {
          "info": {
            "name": "Create a customer in an organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer/organisation/:organisationId",
            "params": [
              {
                "name": "organisationId",
                "value": "1",
                "type": "path",
                "description": "ID of the organization to add the customer to"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new customer that belongs to a specific organization"
