{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Manufacturer Customer Controller API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Customer Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a new customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new customer record"
        },
        {
          "info": {
            "name": "Create a customer in an organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer/organisation/:organisationId",
            "params": [
              {
                "name": "organisationId",
                "value": "1",
                "type": "path",
                "description": "ID of the organization to add the customer to"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new customer that belongs to a specific organization"
        },
        {
          "info": {
            "name": "Get a customer by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer/:customerId",
            "params": [
              {
                "name": "customerId",
                "value": "1",
                "type": "path",
                "description": "ID of the customer to retrieve"
              }
            ]
          },
          "docs": "Retrieves details of a specific customer by their ID"
        },
        {
          "info": {
            "name": "Delete a customer",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer/:customerId",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Hard deletes a customer and removes PII data. The last customer in an organisation cannot be deleted; delete the organisation instead."
        },
        {
          "info": {
            "name": "Get customers with filtering",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/customer/paginated",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "filter specification"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index (0..N)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The size of the page to be returned"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Optional search term"
              }
            ]
          },
          "docs": "Retrieves a paginated list of customers with optional filtering and search using RSQL"
        }
      ]
    }
  ],
  "bundled": true
}