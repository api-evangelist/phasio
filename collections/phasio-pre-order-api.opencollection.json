{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Activity Internal Pre-Order API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pre-Order",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Perform validation and get a quote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/customer/v1/pre-order",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a preliminary quote for and validates a potential order"
        },
        {
          "info": {
            "name": "Get a bulk quote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://m-api.eu.phas.io/api/customer/v1/pre-order/bulk-quote",
            "params": [
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "The currency to generate bulk quotes for"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates tiered pricing quotes for bulk orders of the same part"
        }
      ]
    }
  ],
  "bundled": true
}