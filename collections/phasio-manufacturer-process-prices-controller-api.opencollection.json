{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Manufacturer Process Prices Controller API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Process Prices Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all process pricings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/processes"
          },
          "docs": "Retrieves all manufacturing process pricing configurations for the current operator"
        },
        {
          "info": {
            "name": "Get process pricing by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/processes/:processPricesId",
            "params": [
              {
                "name": "processPricesId",
                "value": "",
                "type": "path",
                "description": "ID of the process pricing to retrieve"
              }
            ]
          },
          "docs": "Retrieves a specific manufacturing process pricing configuration by its ID"
        }
      ]
    }
  ],
  "bundled": true
}