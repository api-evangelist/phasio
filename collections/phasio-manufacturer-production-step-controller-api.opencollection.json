{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phasio Manufacturer Production Step Controller API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Manufacturer Production Step Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Rename production step",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/production-step/:stepId/rename",
            "params": [
              {
                "name": "stepId",
                "value": "",
                "type": "path",
                "description": "ID of the production step to rename"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the name of a production step"
        },
        {
          "info": {
            "name": "Move batches between production steps",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/production-step/move-batches",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Moves batches from one production step to another"
        },
        {
          "info": {
            "name": "Get a production group's nesting placements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/production-step/:stepId/nesting-placements",
            "params": [
              {
                "name": "stepId",
                "value": "",
                "type": "path",
                "description": "ID of the production group (production step)"
              }
            ]
          },
          "docs": "Retrieves the nesting placements tagged to a production group (production step) — the part locations, scales, and orientations of its uploaded nesting file, in nesting order"
        },
        {
          "info": {
            "name": "Get production steps with filtering",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/production-step/paginated",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "RSQL query string for filtering (e.g. paymentStatus=in=(PAID,UNPAID);price>10)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index (0..N)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The size of the page to be returned"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Optional search term"
              }
            ]
          },
          "docs": "Retrieves a paginated list of production steps with optional filtering and search using RSQL"
        },
        {
          "info": {
            "name": "Find nesting placements across production groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/production-step/nesting-placements",
            "params": [
              {
                "name": "workOrderId",
                "value": "",
                "type": "query",
                "description": "Filter by work order ID"
              },
              {
                "name": "requisitionId",
                "value": "",
                "type": "query",
                "description": "Filter by requisition ID"
              }
            ]
          },
          "docs": "Retrieves nesting placements across production groups, filtered by work order or requisition. Provide exactly one filter."
        },
        {
          "info": {
            "name": "Roll back a production group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://m-api.eu.phas.io/api/manufacturer/v1/production-step/:stepId",
            "params": [
              {
                "name": "stepId",
                "value": "",
                "type": "path",
                "description": "ID of the production group (production step) to roll back"
              }
            ]
          },
          "docs": "Deletes a production group (production step) and returns its parts to the steps they came from. Only possible while no parts have left the group."
        }
      ]
    }
  ],
  "bundled": true
}